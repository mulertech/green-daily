{% extends 'base.html.twig' %}

{% block title %}Connexion — Green Daily{% endblock %}

{% block body %}
    <main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center px-6">
        <div class="mb-8 text-center">
            <div class="mb-2 text-5xl">🥗</div>
            <h1 class="text-2xl font-bold text-emerald-700">Green Daily</h1>
        </div>

        {% if error %}
            <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="space-y-4">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div>
                <label for="inputEmail" class="mb-1 block text-sm font-medium text-slate-700">Email</label>
                <input type="email" id="inputEmail" name="_username" value="{{ last_username }}"
                       autocomplete="email" required autofocus
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 focus:outline-none">
            </div>

            <div>
                <label for="inputPassword" class="mb-1 block text-sm font-medium text-slate-700">Mot de passe</label>
                <input type="password" id="inputPassword" name="_password"
                       autocomplete="current-password" required
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-base shadow-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 focus:outline-none">
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="checkbox" name="_remember_me" value="1"
                       class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500">
                Rester connecté sans ressaisir mon mot de passe
            </label>

            <button type="submit"
                    class="w-full rounded-lg bg-emerald-600 px-4 py-2.5 text-base font-medium text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-300">
                Se connecter
            </button>
        </form>

        <div class="mt-6"
             data-passkey
             data-passkey-login-options-url="/passkey/login/options"
             data-passkey-login-url="/passkey/login"
             data-passkey-redirect-url="{{ path('app_home') }}"
             data-passkey-remember-me-selector="#remember_me_passkey"
             data-passkey-error-message="La connexion par clé d'accès a échoué.">
            {# No name attribute: this box is never submitted, the asset reads it to append ?_remember_me=1 #}
            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="checkbox" id="remember_me_passkey"
                       class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500">
                Rester connecté sans redemander ma clé d'accès
            </label>

            <button type="button" data-passkey-action="login"
                    class="mt-3 w-full rounded-lg border border-emerald-600 px-4 py-2.5 text-base font-medium text-emerald-700 transition hover:bg-emerald-50">
                Se connecter avec une clé d'accès
            </button>
            <p data-passkey-status hidden class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>
        </div>
    </main>
{% endblock %}
